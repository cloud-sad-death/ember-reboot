IFS= read -r -d '' BLAST_COPIER_PY <<'BLAST_COPIER_END'
# blast25 copier: one per command. Reads the command's output (stdin, a pipe), copies every byte to the
# terminal at once (the tee), and streams it to the renderer as frames on fd 3. Loop commands are split
# live into one row per item with blast's own rule (a bare absolute path alone on its line at brace depth 0
# starts an item; no item -> one row for the command).
# [2026-10-27 PDT] output before the first item streams live into a row headed by the command itself
# (blast24 joined it to item 1 at the end; holding it back meant nothing was live until an item appeared).
import os,sys,re,signal
for _sig in (signal.SIGINT,signal.SIGTERM,signal.SIGHUP): signal.signal(_sig,signal.SIG_IGN)
header,tsd,iso,loop,verb=sys.argv[1:6]
loop=loop=='1'
term=sys.stdout.buffer;rep=os.fdopen(3,'wb');tty_ok=True
def tee(b):
    # terminal copy; a closed terminal must not stop the report copy
    global tty_ok
    if not tty_ok: return
    try: term.write(b);term.flush()
    except OSError: tty_ok=False
def frame(*f):
    rep.write(b''.join(x.replace(b'\0',b'')+b'\0' for x in f));rep.flush()
H=header.encode('utf-8','surrogateescape');T=tsd.encode();I=iso.encode()
fd=sys.stdin.fileno()
if not loop:
    frame(b'B',H,T,I)
    while True:
        chunk=os.read(fd,65536)
        if not chunk: break
        tee(chunk);frame(b'C',chunk)
    frame(b'E')
    sys.exit(0)
n=0;depth=0;buf=b'';opened=False;pre_row=False
V=verb.encode('utf-8','surrogateescape')
TOK=re.compile(rb'[{}\[\]]')
def lines_out(lines):
    global n,depth,opened,pre_row
    out=[]
    for line in lines:
        label=line.strip(b' \t\r\n')
        if depth==0 and label.startswith(b'/') and b'\t' not in label:
            if opened or pre_row:
                if out: frame(b'C',b''.join(out));out=[]
                frame(b'E');pre_row=False
            n+=1;frame(b'B',(V+b' '+label) if V else label,T,I);opened=True
        elif not opened and not pre_row:
            frame(b'B',H,T,I);pre_row=True
        out.append(line)
        for t in TOK.finditer(line):
            depth=depth+1 if t[0] in (b'{',b'[') else max(0,depth-1)
    if out: frame(b'C',b''.join(out))
while True:
    chunk=os.read(fd,65536)
    if not chunk: break
    tee(chunk)
    buf+=chunk
    parts=buf.split(b'\n')
    buf=parts.pop()                                      # partial last line waits for its line break
    lines=[x+b'\n' for x in parts]
    if len(buf)>1<<20: lines.append(buf);buf=b''          # very long unbroken line: pass it on as is
    lines_out(lines)
if buf: lines_out([buf])
if not opened and not pre_row:
    frame(b'B',H,T,I)
frame(b'E')

