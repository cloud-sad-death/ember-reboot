def run(args,timeout=DEFAULT_COMMAND_TIMEOUT_SECONDS):
    p=subprocess.run(args,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout)
    if p.returncode: raise ValueError(p.stderr.decode('utf-8','replace').strip() or f'exited {p.returncode}')
    return p.stdout.decode('utf-8','replace')

def display_date(now):
    months=('January February March April May June July August September October November December').split()
    return f'{months[now.month-1]} {now.day} {now.year}'

def display_time(now):
    return f'{now.hour%12 or 12:02d}:{now.minute:02d} {"AM" if now.hour<12 else "PM"}'

def terminal_path(path):
    """Double-quoted, pasteable zsh path with shell-active characters escaped."""
    value=str(path).replace('\\','\\\\').replace('"','\\"').replace('$','\\$').replace('`','\\`')
    return '"'+value+'"'

def terminal_box(lines,expand=False):
    lines=[str(value) for value in lines]
    width=max(40,shutil.get_terminal_size((80,24)).columns)
    if expand and lines: width=max(width,max(len(value) for value in lines)+6)
    inside=width-6
    print('╔'+'═'*(width-2)+'╗')
    for value in lines:
        chunks=[value[i:i+inside] for i in range(0,len(value),inside)] or ['']
        for chunk in chunks: print('║  '+chunk+' '*(inside-len(chunk))+'  ║')
    print('╚'+'═'*(width-2)+'╝')

def host_info(zsh_version):
    """Script-independent host chips, in the original template's order."""
    def query(*args):
        try: return run(list(args)).strip()
        except Exception: return ''
    if platform.system()=='Darwin':
        try: hardware=json.loads(query('/usr/sbin/system_profiler','SPHardwareDataType','-json'))['SPHardwareDataType'][0]
        except (ValueError,KeyError,IndexError): hardware={}
        model=query('/usr/sbin/sysctl','-n','hw.model') or hardware.get('machine_model','Unknown')
        chip=hardware.get('chip_type') or query('/usr/sbin/sysctl','-n','machdep.cpu.brand_string') or 'Unknown'
        memory=hardware.get('physical_memory','')
        if not memory:
            size=query('/usr/sbin/sysctl','-n','hw.memsize')
            if size.isdigit(): memory=f'{int(size)/1024**3:g}GB'
        hostname=query('/bin/hostname') or platform.node() or 'Unknown'
        firmware=hardware.get('boot_rom_version') or hardware.get('system_firmware_version','')
        if not firmware:
            mini=query('/usr/sbin/system_profiler','SPHardwareDataType','-detailLevel','mini')
            match=re.search(r'^\s*System Firmware Version:\s*(.+?)\s*$',mini,re.M)
            if match: firmware=match.group(1)
        # [2026-10-25 PDT] MEMORY = '<chip> <size>' (e.g. 'Apple M5 24GB'); HOSTNAME label is HOST.
        memory=' '.join(filter(None,[chip,re.sub(r'(\d)\s+(GB|TB|MB)\b',r'\1\2',memory)]))
        return [('macOS',' '.join(filter(None,[query('/usr/bin/sw_vers','-productVersion'),query('/usr/bin/sw_vers','-buildVersion')]))),
                ('MODEL',' '.join(filter(None,[model,hardware.get('model_number','')])) or 'Unknown'),
                ('MEMORY',memory or 'Unknown'), ('HOST',hostname),
                ('System Firmware Version',firmware or 'Unknown'), ('ZSH',zsh_version)]
    try: memory=f'{round(os.sysconf("SC_PHYS_PAGES")*os.sysconf("SC_PAGE_SIZE")/1024**3):g}GB'
    except (ValueError,OSError): memory=''
    cpu=''
    try:
        match=re.search(r'^model name\s*:\s*(.+?)\s*$',Path('/proc/cpuinfo').read_text(errors='replace'),re.M)
        if match: cpu=match.group(1)
    except OSError: pass
    memory=' '.join(filter(None,[cpu or platform.processor() or platform.machine(),memory]))
    return [(platform.system(),platform.release()),('MODEL',platform.machine() or 'Unknown'),
            ('MEMORY',memory or 'Unknown'),
            ('HOST',platform.node() or 'Unknown'),('System Firmware Version','Unknown'),('ZSH',zsh_version)]

def display_blocks(text):
    if len(text)<=DISPLAY_BLOCK_CHARS: return html.escape(text)
    blocks=[];start=0
    while start<len(text):
        end=min(len(text),start+DISPLAY_BLOCK_CHARS)
        if end<len(text):
            newline=text.rfind('\n',start,end)
            if newline>start: end=newline+1
        blocks.append('<span class="render-block">'+html.escape(text[start:end])+'</span>')
        start=end
    return ''.join(blocks)

