def type_name(path,reader=''):
    name=path.name
    if name.casefold()=='.ds_store': return 'dsstore'
    if name.casefold() in PLP_FILENAMES: return name
    # [2026-10-27 PDT] rev 6: type = the file's own extension, lowercased, read from the path string (zsh ${(L)f:e});
    # a plp hit is not proof of a plist. No extension: known names keep their name, else 'unknown'.
    ext=path.suffix.lower().lstrip('.')
    if ext: return ext
    return {'sqlite':'db','plist':'plist','text':'text'}.get(reader,'unknown')

def format_counts(counts,limit=5):
    top=sorted(counts.items(),key=lambda item:(-item[1],item[0]))[:limit]
    return ', '.join(f'{kind} ({count})' for kind,count in top) or 'none'


