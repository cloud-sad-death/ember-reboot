    # deck=('<div class="hdr-stats description-row" id="report-description-row"'+('' if description.strip() else ' hidden')+
    #       '><div class="kv description-pill"><span class="v path" id="report-description">'+esc(description)+'</span></div></div>\n')
    deck=''
    common={'TITLE':esc(name+': '+hostname),'SCRIPTNAME':esc(name),'TARGETNAME':esc(hostname),'HOSTINFO':host_markup,
            'FAVICON':esc(favicon,quote=True),'DATE':display_date(started),'TIME':display_time(started),'STATSDECK':deck}
