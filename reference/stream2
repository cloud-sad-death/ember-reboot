          ('MEMORY',' '.join(filter(None,[re.sub(r'\s+(?=[KMGT]B\b)','',memory),chip]))),('HOST',host_full),
          ('System Firmware Version',firmware),('ZSH',zsh_version)]
    host_markup=''.join('<div class="kv"><span class="k">'+esc(k)+'</span><span class="v">'+esc(v or 'Unknown')+'</span></div>' for k,v in host)
    hostname=dict(host).get('HOST','') or platform.node()
