STATS_DECK = r"""<div class="hdr-stats" aria-label="Report summary"><div class="kv"><span class="k">Source</span><span class="v path">@@SOURCE@@</span></div><div class="kv"><span class="k">Target</span><span class="v path">@@TARGET@@</span></div><div class="kv"><span class="k">Dirs</span><span class="v">@@DIRS@@</span></div><div class="kv"><span class="k">Files</span><span class="v">@@FILES@@</span></div><div class="kv"><span class="k">Types</span><span class="v">@@TYPES@@</span></div></div>
