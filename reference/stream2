    b=[i for i,l in enumerate(lines) if l.startswith('# BEGIN REPORT CONFIG')];e=[i for i,l in enumerate(lines) if l.startswith('# END REPORT CONFIG')]
    config=''.join(lines[b[0]:e[0]+1]) if len(b)==1 and len(e)==1 and e[0]>b[0] else ''
