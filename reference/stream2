        S['j']=json_path(n).open('wb');S['jfirst']=True;S['rc']={}
        jw(json.dumps({'run_id':base,'host':hostname,'part':n,'started':datetime.now().astimezone().isoformat(),'description':description},ensure_ascii=False)[:-1]+',"entries":[')
        S['opened'].append(str(part_path(n)))
    def close_part(next_exists):
        # Final for this part: Config metadata row, pager (with the next part when one follows), closing tags.
        n=S['part']
        cfg=('<div class="row metadata-item meta-row" id="metadata-config-p'+str(n)+'" data-copy-path="config"><div class="row-hd meta-hd"><span class="row-cmd">config</span>'+META_BUTTONS+
             '</div><div class="row-output"><div class="out"><pre class="ln">'+esc(config)+'</pre></div></div></div>\n')
        w(cfg.encode('utf-8'))
        w(('<script>__u('+json.dumps({'parts':n+1 if next_exists else n})+')</script>\n').encode('utf-8')+tail)
        S['f'].close()
        jw('],"exit_codes":'+json.dumps(S['rc'])+',"entry_count":'+str(S['rows_in_part'])+',"ended":'+json.dumps(datetime.now().astimezone().isoformat())+'}\n');S['j'].close()
    reserve=len(tail)+len(config)*2+4096
    def row_write_start():
        # Card head + JSON entry head of the open row, into the open part. Remembers where the row begins.
        r=S['row']
        r['hpos']=S['size'];r['jpos']=S['j'].tell();r['alone']=S['rows_in_part']==0
        card=('<div class="row'+(' collapsed' if collapse else '')+'" id="'+r['id']+'" data-copy-path="'+esc(r['hdr'],quote=True)+'"><div class="row-hd"><div class="row-strip"><span class="row-ts"><b class="ts-d">'+esc(['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'][int(r['iso'][5:7])-1]+' '+r['iso'][8:10]+' '+r['iso'][2:4])+'</b>&nbsp;&nbsp;'+esc(r['tsd'])+'</span>'+BUTTONS+
              '</div><div class="row-cmd">'+esc(r['hdr'])+'</div></div><div class="row-output"><div class="out"><pre class="ln">').encode('utf-8')
        jhead=('' if S['jfirst'] else ',')+json.dumps({'id':r['id'],'ts':r['iso'],'ts_display':r['tsd'],'command':r['hdr']},ensure_ascii=False)[:-1]+',"output":"'
        w(card);jw(jhead);S['rows_in_part']+=1;S['jfirst']=False
        r['out']=0
    def row_open(hdr,tsd,iso):
        S['total_rows']+=1;ident=f'row-{S["total_rows"]}'
        S['row']={'hdr':hdr,'tsd':tsd,'iso':iso,'id':ident,'chars':0,'blk':0,'span':False,'dec':codecs.getincrementaldecoder('utf-8')('replace'),'pend':''}
        row_write_start();S['stamp'].append(ident)
