def read_fields_bytes(stream):
    # NUL-framed fields. C payloads have their NUL bytes removed by the copier.
    buf=b''
    while True:
        chunk=stream.read1(1<<20)
        if not chunk: break
        buf+=chunk
        *done,buf=buf.split(b'\0')
        for item in done: yield item
    if buf: yield buf

