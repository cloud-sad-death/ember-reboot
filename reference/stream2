BLAST_FD=""; BLAST_IN=""; BLAST_PID=""
# Renderer: one long-lived python (coproc). It never writes to the terminal: it answers blast on its stdout
# (BLAST_IN) and blast prints "-> <part>" and "saved ..." itself, synchronously, where blast24 printed them.
# SIGINT is ignored so Ctrl-C never kills the report mid-write.
blast_report_begin() {
  coproc { trap '' INT; exec python3 -u -c "$BLAST_ENGINE_PY" "$FX_ROOT" "$BASE" "$SCRIPT_NAME" "$ZSH_VERSION" \
      "$SCRIPT_PATH" "$B21_START_DIR" "$BLAST_FAVICON" "$ROTATE_BYTES" "$REPORT_DESCRIPTION" "$REPORT_SETTINGS" \
      "$SYS_OS_NAME" "$SYS_OS_VERSION" "$SYS_OS_BUILD" "$SYS_MODEL_ID" "$SYS_MODEL_NUMBER" "$SYS_CHIP" \
      "$SYS_MEMORY" "$SYS_FIRMWARE" "$HOSTNAME_FULL" 2>&$B19_STDERR }
  BLAST_PID=$!
  exec {BLAST_FD}>&p
  exec {BLAST_IN}<&p
  coproc :   # release the shell's coproc pipes; BLAST_FD is now the renderer's only writer
  blast_sync
}
blast_rc() { [[ -n $BLAST_FD ]] && print -rn -u $BLAST_FD -- "X"$'\0'"$1"$'\0'; }
# Sync with the renderer: prints "-> <path>" for every part opened since the last sync (blast24's line).
blast_sync() {
  [[ -n $BLAST_FD ]] || return 0
  print -rn -u $BLAST_FD -- "S"$'\0' 2>/dev/null || return 0
  local b25_line
  while IFS= read -r -u $BLAST_IN b25_line; do
    case $b25_line in
      'P '*) printf -- '-> %s\n' "${b25_line#P }" ;;
      K) break ;;
    esac
  done
}
blast_report_end() {
  [[ -n $BLAST_FD ]] || return 0
  # Q: finish now (a background job may still hold a copy of the pipe, so EOF alone could wait on it)
  local b25_line b25_done=""
  print -rn -u $BLAST_FD -- "Q"$'\0' 2>/dev/null
  exec {BLAST_FD}>&-; BLAST_FD=""
  while IFS= read -r -u $BLAST_IN b25_line; do
    [[ $b25_line == 'D '* ]] && { b25_done=${b25_line#D }; break; }
  done
  exec {BLAST_IN}<&-; BLAST_IN=""
  wait $BLAST_PID 2>/dev/null
  if [[ -n $b25_done ]]; then
    local -a b25_f; b25_f=("${(@ps:\t:)b25_done}")
    printf '\nsaved %s entries\n  html: %s\n  json: %s\n' "${b25_f[1]}" "${b25_f[2]}" "${b25_f[3]}"
  fi
}

# ── traps ──────────────────────────────────────────────────────────────
cleanup() {
  local b19_exit=$?
  # exit/TERM inside eval may reach EXIT while descriptors still point at the copier.
  if [[ $B19_ACTIVE == 1 ]]; then
    exec 1>&$B19_STDOUT 2>&$B19_STDERR
    coproc :
    wait "$B19_TEE_PID" 2>/dev/null
    B19_ACTIVE=0
    blast_rc "$b19_exit"
  fi
  [[ -n $B19_TTY_ORIGINAL ]] && stty "$B19_TTY_ORIGINAL" </dev/tty
  blast_report_end      # renderer closes any open row, appends Config + pager + closing tags to the open part
  return "$b19_exit"
}
trap cleanup EXIT
trap 'B19_INTERRUPTED=1; if [[ $B19_READING == 1 ]]; then return 130; fi' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# ── loop detection (item 13) ─────────────────────────────────────────
# Detects the two patterns from the spec: `find ... -exec ...` and
# `for/while ... find|ls ... do ... done`. This heuristic is carried
# over as-is from a prior working script (tlog4) rather than invented
# fresh — it's proven, not new.
is_per_item_loop() {
  local cmd="$1"
  if printf '%s' "$cmd" | grep -qE '(^|[[:space:];])find[[:space:]].*-exec[[:space:]]'; then return 0; fi
  if printf '%s' "$cmd" | grep -qE '(^|[[:space:];])(for|while)[[:space:]]'; then return 0; fi
  return 1
}

# Splits a chunk of already-captured output into per-item pieces on the
# same boundary tlog4 used successfully: a bare absolute path alone on
# its own line (e.g. what `find -exec ... \;` or `plutil -p <path>`
# naturally print as each item starts). Anything before the first such
# line in this chunk is treated as a continuation of whatever item was
# still open from an earlier chunk (tracked by the splitter).
#
# A bare path line only counts as a NEW item boundary when it appears
# at brace/bracket depth 0 — i.e. between items, not inside one. This
# matters because plutil -p renders some plist value types (CFURL, some
# data blobs) as a bare, unquoted path on its own line WITHIN an
# item's output (e.g. an "Owners" or CFURL-typed value nested inside
# the dict) — without depth tracking, that inner line was
# indistinguishable from the next item's real -print path, and a
# single item's dump got chopped into two mislabeled fragments (both
# showing the same path, output scrambled). Depth state persists across
# splitter calls the same way item_n does, since a chunk can end
# mid-structure.
#
# This only recognizes loops whose iterated tool announces a path per
# item — that covers the plist/plutil case in the spec and most
# find -exec find/ls patterns, but not every conceivable loop body.
# Resolves a command's underlying definition if it's a shell function or
# alias, so the loop detector can see inside wrapper functions like
# plup_globalpref (whose actual find/while loop lives in the function
# body, not in the four words typed at the prompt). Falls back to the
# literal command text for anything that isn't a function/alias — an
# inline `find ... -exec` still detects exactly as before.
resolve_for_detection() {
  local cmd="$1"
  local head_word body=""
  head_word=$(printf '%s' "$cmd" | awk '{print $1; exit}')
  [ -z "$head_word" ] && { printf '%s' "$cmd"; return; }

  body=$(functions -- "$head_word" 2>/dev/null)
  if [ -n "$body" ]; then
    printf '%s' "$body"
  else
    printf '%s' "$cmd"
  fi
}

# Extracts the "verb" applied to each item inside a per-item loop -- e.g.
# for find "$dir" -type f -name '*.plist' -exec plutil -p {} \; this
# returns "plutil -p", the command template minus the trailing {}/\;/+
# placeholder. Falls back to "" (caller then shows the bare path only,
# same as before) if no recognizable verb can be isolated. This is what
# was missing: split_loop_output correctly finds each item's path, but
# the label was never combined with the verb that acts on it (bug 13.5).
resolve_loop_verb() {
  local body="$1"
  local verb=""

  verb=$(printf '%s' "$body" | tr '\n' ' ' | \
    sed -n 's/.*-exec[[:space:]]\{1,\}\(.*\)[[:space:]]\{1,\}{}.*/\1/p' | head -1)

  if [ -z "$verb" ]; then
    verb=$(printf '%s' "$body" | awk '
      /(^|[[:space:];])do([[:space:];]|$)/ { indo=1 }
      indo && !/^[[:space:]]*(sudo[[:space:]]+|time[[:space:]]+|env[[:space:]]+|command[[:space:]]+)*(find|while|for|do|done|if|then|fi|elif|else)([[:space:];]|$)/ && NF {
        line=$0
        sub(/^[[:space:]]*/, "", line)
        print line
        exit
      }
    ')
    verb=$(printf '%s' "$verb" | sed -E 's/[[:space:]]*("?\$[A-Za-z_{][A-Za-z0-9_}]*"?|\{\}).*$//')
  fi

  verb="${verb#"${verb%%[![:space:]]*}"}"
  verb="${verb%"${verb##*[![:space:]]}"}"
  printf '%s' "$verb"
}

# ── command execution helper ────────────────────────────────────────
# 2026-09-29: foreground execution in THIS zsh, with one blocking byte copier.
# Internal names are prefixed so normal user variables survive between commands.
# 2026-09-30: contain return in the current process; EXIT still records real status.
execute_input() {
  builtin eval "$1"
}

run_cmd() {
  local b19_cmd="$1"
  [[ -n ${b19_cmd//[[:space:]]/} ]] || return 0
  local b19_iso=$(date "+%Y-%m-%dT%H:%M:%S%z")
  local b19_display=$(date "+%I:%M %p")   # [2026-10-27 PDT] t82u: row time = hh:MM AM/PM (plp-h/rgq/fqdv/condump)
  local b19_detection=$(resolve_for_detection "$b19_cmd")
  local b19_loop=0 b19_verb=""
  if is_per_item_loop "$b19_detection"; then
    b19_loop=1
    b19_verb=$(resolve_loop_verb "$b19_detection")
  fi
  B19_CMD="$b19_cmd"
  # [2026-10-27 PDT] blast25: the copier (tee) is a coproc: terminal copy + live frames to the renderer.
  # Ctrl-C is ignored in the copier so it drains output after the foreground command is interrupted.
  coproc { trap '' INT; exec python3 -u -c "$BLAST_COPIER_PY" "$b19_cmd" "$b19_display" "$b19_iso" "$b19_loop" "$b19_verb" \
           >&$B19_STDOUT 2>&$B19_STDERR 3>&$BLAST_FD }
  B19_TEE_PID=$!
  B19_ACTIVE=1
  B19_INTERRUPTED=0
  B19_TTY_RUN=""
  [[ -n $B19_TTY_ORIGINAL ]] && B19_TTY_RUN=$(stty -g </dev/tty)
  [[ $B19_ALIAS_OPTION == on ]] && setopt aliases
  # This function boundary contains `return` without creating a child shell.
  # >&p (zsh's own coproc fd, closed in child processes): a background job the command starts can't hold the pipe open
  execute_input "$b19_cmd" >&p 2>&1
  local b19_rc=$?
  B19_ALIAS_OPTION=$options[aliases]
  unsetopt aliases
  [[ $B19_INTERRUPTED == 1 ]] && b19_rc=130
  B19_INTERRUPTED=0
  coproc :   # closes the shell's end of the copier pipe: the copier sees EOF and finishes the row
  wait "$B19_TEE_PID"
  B19_ACTIVE=0
  B19_TEE_PID=""
  blast_rc "$b19_rc"
  blast_sync      # a part opened during this command prints "-> <path>" here, after its output (blast24's place)
  if [[ -n $B19_TTY_RUN ]]; then
    stty "$B19_TTY_RUN" </dev/tty
  fi
  CUR_DIR="$PWD"
  return 0
}

# ── syntax check helper ────────────────────────────────────────────────
is_complete() {
  # Syntax check only: -f suppresses startup files, -n executes nothing.
  printf '%s\n' "$1" | "$SHELL_BIN" -fn >/dev/null 2>&1
}

# A function boundary lets SIGINT return from zsh's otherwise-restarted tty read.
read_input() {
  IFS= read -r line
}

# ── prompt + ingest ────────────────────────────────────────────────────
# [2026-10-27 PDT] t82u: description commented out.
# if [[ -t 0 && -z ${CAST_DESCRIPTION+x} ]]; then
#   printf 'Report description (optional; Enter to skip): ' >/dev/tty
#   IFS= read -r REPORT_DESCRIPTION || REPORT_DESCRIPTION=""
# fi
blast_report_begin

# Check if stdin is a terminal (interactive) or piped (batch)
if [ -t 0 ]; then
  # Interactive mode: read line-by-line with prompt
  echo "=== $SCRIPT_NAME logger running. Type 'exit' or Ctrl-D to finish. ==="
  CMD_BUFFER=""
  while true; do
    # Print prompt directly to tty so it never mixes into input
    if [ -z "$CMD_BUFFER" ]; then
      printf '%s %s %s > ' "$(date '+%b %d')" "$(date '+%I:%M %p')" "$CUR_DIR" >/dev/tty
    else
      printf '> ' >/dev/tty
    fi

    B19_READING=1
    read_input
    read_rc=$?
    B19_READING=0

    # Ctrl-C cancels current input; Ctrl-D ends the logger.
    if [[ $B19_INTERRUPTED == 1 ]]; then
      B19_INTERRUPTED=0
      CMD_BUFFER=""
      printf '\n'
      continue
    fi
    # Ctrl-D (EOF): reject incomplete buffered input, then exit
    if [ $read_rc -ne 0 ] && [ -z "$line" ]; then
      if [ -n "$CMD_BUFFER" ]; then
        print -u2 "$SCRIPT_NAME: incomplete input was not executed"
      fi
      break
    fi

    # 'exit' command on empty buffer
    if [ "$line" = "exit" ] && [ -z "$CMD_BUFFER" ]; then
      break
    fi

    # Accumulate line into buffer
    if [ -n "$CMD_BUFFER" ]; then
      CMD_BUFFER="${CMD_BUFFER}"$'\n'"${line}"
    else
      CMD_BUFFER="$line"
    fi

    # Skip buffer that is only whitespace
    trimmed="${CMD_BUFFER// /}"
    trimmed="${trimmed//$'\t'/}"
    trimmed="${trimmed//$'\n'/}"
    [ -z "$trimmed" ] && { CMD_BUFFER=""; continue; }

    # Check if buffer is a syntactically complete command
    if is_complete "$CMD_BUFFER"; then
      run_cmd "$CMD_BUFFER"
      CMD_BUFFER=""
    fi
  done
else
  # Non-interactive mode: read all from stdin (piped input) — batch behavior
  echo "=== $SCRIPT_NAME: processing piped input ==="
  accum=""
  while IFS= read -r line || [ -n "$line" ]; do
    if [ -z "$accum" ]; then
      accum="$line"
    else
      accum="${accum}"$'\n'"${line}"
    fi
    trimmed="${accum// /}"
    trimmed="${trimmed//$'\t'/}"
    trimmed="${trimmed//$'\n'/}"
    [ -z "$trimmed" ] && { accum=""; continue; }

    if is_complete "$accum"; then
      run_cmd "$accum"
      accum=""
    fi
  done

  # Leftover (genuinely unterminated input)
  if [ -n "$accum" ]; then
    trimmed="${accum// /}"
    trimmed="${trimmed//$'\t'/}"
    trimmed="${trimmed//$'\n'/}"
    if [ -n "$trimmed" ]; then
      printf '\n[%s] %s (unterminated input)\n' \
        "$(date "+%H:%M:%S")" "$(printf '%s' "$accum" | head -1)"
      print -u2 "$SCRIPT_NAME: incomplete input was not executed"
    fi
  fi
fi

