def main():
    (outdir,base,name,zsh_version,source,target,favicon,target_bytes,description,settings_json,
     os_name,os_version,os_build,model_id,model_number,chip,memory,firmware,host_full)=sys.argv[1:20]
    settings=json.loads(settings_json)
    limits={'output_font_px':(6,48),'output_line_height':(1,4),'row_font_px':(6,48),'timestamp_font_px':(6,48),'toc_font_px':(6,48),'maximum_indent_percent':(0,50),'part_columns':(1,10),'part_button_width_px':(16,96),'part_button_height_px':(16,96),'scroll_duration_ms':(0,2000),'output_block_chars':(256,1048576)}
    for key,(low,high) in limits.items():
        value=settings[key]
        if isinstance(value,bool) or not isinstance(value,(int,float)) or not low<=value<=high:raise ValueError('Invalid report setting: '+key)
    block_chars=int(settings['output_block_chars']);collapse=bool(settings['collapse_outputs_initially'])
    target_bytes=int(target_bytes);hard_cap=target_bytes+target_bytes//2
    outdir=Path(outdir);esc=html.escape
