.out strong { font-weight: 700; color: var(--ink); }
.out .v { color: var(--accent); }

.out strong .v { color: inherit; }
.raw { display: none; }


/* [2026-10-19 PDT] Accent swatches parked small at the toolbar row's left; final home pending. */
.accent-switcher { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; opacity: .8; }
.accent-switcher__label { font-size: 10px; font-weight: 700; letter-spacing: .1em; color: var(--paper); margin-right: 4px; text-transform: uppercase; }
.accent-dot { width: 14px; height: 14px; border: 2px solid var(--paper); border-radius: 0; cursor: pointer; transition: transform .12s; } 
.accent-dot:hover { transform: scale(1.15); }
.accent-dot.active { box-shadow: 0 0 0 2px var(--ink), 0 0 0 4px var(--paper); }


.hdr-controls { display: flex; gap: 5px; margin-left: auto; }
.hdr-controls button { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--paper); transition: background .12s, color .12s; }
.hdr-controls button:hover { background: var(--paper); color: var(--ink); }
.hdr-controls .fold-ic { transition: transform .15s; }
.hdr-controls button.collapsed .fold-ic { transform: rotate(-90deg); }


.btn-fold { margin-left: 6px; }
.btn-fold .fold-ic { transition: transform .15s; }
.icon-cluster button.saved { background: var(--accent); color: var(--paper); }


.row.collapsed .row-output { display: none; } 
.row.collapsed .btn-fold .fold-ic { transform: rotate(-90deg); }


.resizer { width: 6px; flex-shrink: 0; height: 100vh; position: sticky; top: 0; cursor: col-resize; background: var(--ink); }
.resizer:hover, .resizer.dragging { background: var(--accent); }
body.resizing { cursor: col-resize; user-select: none; }

@media (max-width: 720px) {
  main { display: block; }
  aside { width: auto; height: auto; position: static; border-right: 0; border-bottom: 3px solid var(--ink); }
  .resizer { display: none; } 
}

