        r=S['row']
        S['f'].truncate(r['hpos']);S['f'].seek(r['hpos']);S['size']=r['hpos']
        S['j'].truncate(r['jpos']);S['j'].seek(r['jpos']);S['rows_in_part']-=1
        S['jfirst']=S['rows_in_part']==0
        close_part(True);open_part()
        row_write_start()                      # same id, header and time; now the part's first row
    def split_row():
        # blast25s: close the row here, close the part, and continue the same row in the next part.
        r=S['row']
        w((('</span>' if r['span'] else '')+'</pre></div></div></div>\n').encode('utf-8'));jw('"}')
        close_part(True);open_part()
        r['chars']=0;r['blk']=0;r['span']=False
        row_write_start()                      # same id, header and time; now the part's first row
    def emit(text):
        # Escape and append one piece of the open row (pieces end at a line break except a forced flush).
        r=S['row']
        if not text: return
        if S['size']+len(esc(text).encode('utf-8'))+64+reserve>hard_cap:
            if r['out']: split_row()
            elif not r['alone']: move_row()
        pre=''
        if r['chars']>=block_chars and not r['span']: pre='<span class="render-block">';r['span']=True;r['blk']=0
        post=''
        r['chars']+=len(text);r['blk']+=len(text)
        if r['span'] and r['blk']>=block_chars and text.endswith('\n'): post='</span>';r['span']=False
        data=pre.encode()+esc(text).encode('utf-8')+post.encode();jt=json.dumps(text,ensure_ascii=False)[1:-1]
